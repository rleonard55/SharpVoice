<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SharpVoice</AssemblyName>
    <ApplicationIcon>../SharpVoice.UI/Assets/microphone-neutral.ico</ApplicationIcon>
    <ApplicationManifest>../SharpVoice.UI/app.manifest</ApplicationManifest>
    <SharpVoiceVersion Condition="'$(SharpVoiceVersion)' == ''">0.1.7</SharpVoiceVersion>
    <Version>$(SharpVoiceVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <InternalsVisibleTo Include="SharpVoice.Tests" />
    <ProjectReference Include="../SharpVoice.Audio/SharpVoice.Audio.csproj" />
    <ProjectReference Include="../SharpVoice.Speech/SharpVoice.Speech.csproj" />
    <ProjectReference Include="../SharpVoice.Refiner/SharpVoice.Refiner.csproj" />
    <ProjectReference Include="../SharpVoice.UI/SharpVoice.UI.csproj" />
  </ItemGroup>
</Project>
